# MyLogger42 example configuration. Copy to .env and fill in real values.
#
# Quick bootstrap:
#
#   ./bin/mylogger42 admin generate-secrets
#       → prints fresh KEY_PEPPER and SESSION_SECRET; paste both lines.
#
#   ./bin/mylogger42 admin hash-password
#       → reads a password from stdin; paste output as ADMIN_PASSWORD_HASH.
#       (or skip ADMIN_USERNAME/ADMIN_PASSWORD_HASH and run
#        `./bin/mylogger42 admin create-user` after first start instead.)

# --- Required secrets -------------------------------------------------

# HMAC pepper used to fingerprint project ingest keys. The plaintext
# secrets are NEVER stored — only HMAC-SHA256(KEY_PEPPER, secret) is.
# Must be hex-encoded, ≥32 bytes after decode (=64 hex chars).
# Generate with: `./bin/mylogger42 admin generate-secrets`
KEY_PEPPER=replace-me-with-64-hex-chars

# HS256 secret used to sign session JWTs (admin login cookie).
# Same length and format requirements as KEY_PEPPER.
# Rotating this invalidates ALL outstanding sessions and forces
# everyone to log in again.
SESSION_SECRET=replace-me-with-different-64-hex-chars

# --- Storage ----------------------------------------------------------

# Storage driver: "sqlite" (default, pure-Go) or "postgres".
DB_DRIVER=sqlite

# DSN. For sqlite, a filesystem path. For postgres, a libpq URL.
# Examples:
#   DB_DSN=./data/mylogger42.db
#   DB_DSN=postgres://user:pass@localhost:5432/mylogger42?sslmode=disable
DB_DSN=./data/mylogger42.db

# --- Admin bootstrap (first-start only) -------------------------------
#
# When the users table is empty AND BOTH variables below are set, the
# server seeds an admin user from these on startup. On subsequent starts
# (users table non-empty) both vars are ignored — the DB is the source
# of truth. Leave them unset and run `mylogger42 admin create-user`
# interactively after first start if you prefer.

# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=$2a$12$replace-with-output-of-`mylogger42 admin hash-password`

# --- Operational ------------------------------------------------------

# Default retention window in days. Per-project overrides win;
# `retentionDays = 0` on a project means "retain forever" for that
# project.
RETENTION_DAYS=30

# Set to true when running behind a TLS-terminating reverse proxy
# (Caddy, Nginx, Traefik). Tells the server to trust X-Forwarded-Proto
# when deciding whether to mark the session cookie Secure.
TRUST_FORWARDED_PROTO=false

# HTTP listen port.
HTTP_PORT=8080

# Verbosity of the server's own access/operational log.
LOG_LEVEL=info
