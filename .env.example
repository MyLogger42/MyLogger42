# MyLogger42 example configuration. Copy to .env and fill in real values.

# REQUIRED. Clients must send this in the X-API-Key header on POSTs to
# /api/v1/logs and /api/v1/logs/batch. There is no UI auth.
INGEST_API_KEY=replace-me-with-a-long-random-string

# Storage driver: "sqlite" (default) or "postgres".
DB_DRIVER=sqlite

# DSN. For sqlite, a filesystem path. For postgres, a libpq URL.
# Examples:
#   DB_DSN=./data/mylogger42.db
#   DB_DSN=postgres://user:pass@localhost:5432/mylogger42?sslmode=disable
DB_DSN=./data/mylogger42.db

# Days to keep log entries. 0 disables the retention worker entirely.
RETENTION_DAYS=30

# HTTP listen port.
HTTP_PORT=8080

# Verbosity of the server's own access/operational log.
LOG_LEVEL=info
